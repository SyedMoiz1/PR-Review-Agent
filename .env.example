# copy to .env and fill in
OPENAI_API_KEY=            # embeddings (text-embedding-3-small) + RAGAS judge
ANTHROPIC_API_KEY=         # agent, when LLM_PROVIDER=anthropic
GITHUB_TOKEN=              # needs pull request read/write on the target repo
GITHUB_REPO=owner/name     # only used by the module __main__ smoke tests
GITHUB_WEBHOOK_SECRET=     # same value as in the GitHub webhook settings
QDRANT_COLLECTION=codebase

# optional
# LLM_PROVIDER=anthropic   # or "openai" to use GPT-4o
# LLM_MODEL=claude-opus-5-5
# QDRANT_URL=https://...   # remote Qdrant (Qdrant Cloud / Fly.io); defaults to localhost:6333
# QDRANT_API_KEY=
# RAGAS_JUDGE_MODEL=gpt-4o-mini
